# Telegram Bot notifications (required for alerts)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Single numeric chat ID or comma-separated list of chat IDs
TELEGRAM_CHAT_ID=123456789

# Appointedd target widget configuration
APPOINTEDD_WIDGET_ID=6af497ce58a51703b9fb8202
APPOINTEDD_BOOKING_URL=https://swiateczna-pracownia.appointedd.com/booking-widget/6af497ce58a51703b9fb8202

# Target date window (inclusive, in TIMEZONE)
DATE_FROM=2026-12-04
DATE_TO=2026-12-06
TIMEZONE=Europe/Warsaw

# Minimum number of free spaces required per slot (1 = alert on any cancellation/opening)
MIN_SPACES=1

# Default check interval in minutes (used in daemon mode)
CHECK_INTERVAL_MINUTES=1

# State & log paths
STATE_PATH=data/slots_state.json
RUN_LOG_PATH=data/monitor_runs.log
